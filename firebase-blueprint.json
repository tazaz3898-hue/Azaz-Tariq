{
  "entities": {
    "Profile": {
      "title": "User Profile",
      "description": "Stores user professional information and role.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "bio": { "type": "string" },
        "skills": { "type": "array", "items": { "type": "string" } },
        "role": { "type": "string", "enum": ["freelancer", "client"] },
        "avatar": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "email", "role"]
    },
    "Job": {
      "title": "Job Posting",
      "description": "A freelance project posted by a client.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "budget": { "type": "number" },
        "clientId": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "in-progress", "completed", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "description", "clientId", "status"]
    },
    "Application": {
      "title": "Job Application",
      "description": "A proposal submitted by a freelancer to a job.",
      "type": "object",
      "properties": {
        "jobId": { "type": "string" },
        "freelancerId": { "type": "string" },
        "coverLetter": { "type": "string" },
        "bidAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["jobId", "freelancerId", "status"]
    },
    "Course": {
      "title": "Learning Course",
      "description": "Educational content for freelancers.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "category": { "type": "string" },
        "level": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["title", "category"]
    },
    "CommunityPost": {
      "title": "Community Post",
      "description": "A post in the community forum.",
      "type": "object",
      "properties": {
        "authorId": { "type": "string" },
        "content": { "type": "string" },
        "likes": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "content"]
    }
  },
  "firestore": {
    "/profiles/{uid}": { "schema": "Profile", "description": "User profiles indexed by UID." },
    "/jobs/{jobId}": { "schema": "Job", "description": "List of available jobs." },
    "/jobs/{jobId}/applications/{appId}": { "schema": "Application", "description": "Proposals for a specific job." },
    "/courses/{courseId}": { "schema": "Course", "description": "Educational courses." },
    "/community/{postId}": { "schema": "CommunityPost", "description": "Community forum posts." }
  }
}
